generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  emailVerified        Boolean               @default(false)
  image                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  role                 String                @default("PENDING")
  status               String                @default("ACTIVE")
  onboardingDone       Boolean               @default(false)
  sessions             Session[]
  accounts             Account[]
  brandMemberships     BrandMember[]
  creatorProfile       CreatorProfile?
  verificationRequests VerificationRequest[] @relation("VerificationApplicant")
  reviews              VerificationRequest[] @relation("VerificationReviewer")
  sentMessages         CollaborationMessage[]
  notifications        Notification[]
  auditEvents          AuditLog[]
  assignedCampaigns    Campaign[] @relation("CampaignManager")
  sentInvitations      CampaignInvitation[]
  mediaAssets          MediaAsset[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model Brand {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  website      String?
  industry     String?
  description  String?
  logoUrl      String?
  city         String?
  state        String?
  address      String?
  contactName  String?
  contactEmail String?
  phone        String?
  gstin        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  members      BrandMember[]
  campaigns    Campaign[]
  shortlists   BrandShortlistItem[]
  invitations  CampaignInvitation[]
}

model BrandMember {
  id        String   @id @default(cuid())
  userId    String
  brandId   String
  title     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  @@unique([userId, brandId])
  @@index([brandId])
}

model CreatorProfile {
  id             String          @id @default(cuid())
  userId         String          @unique
  displayName    String?
  bio            String?
  city           String?
  state          String?
  categories     String[]        @default([])
  specialties    String[]        @default([])
  languages      String[]        @default([])
  isPublic       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioItems PortfolioItem[]
  socialAccounts SocialAccount[]
  applications   CampaignApplication[]
  collaborations Collaboration[]
  shortlists      BrandShortlistItem[]
  invitations     CampaignInvitation[]
  @@index([isPublic, city, state])
}

model PortfolioItem {
  id               String         @id @default(cuid())
  creatorProfileId String
  title            String
  description      String?
  mediaUrl         String
  mediaType        String         @default("IMAGE")
  publicId         String?
  resourceType     String?
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  @@index([creatorProfileId, sortOrder])
}

model SocialAccount {
  id                           String                        @id @default(cuid())
  creatorProfileId             String
  platform                     String
  handle                       String
  profileUrl                   String
  followers                    Int?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  creatorProfile               CreatorProfile                @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  source                String   @default("MANUAL")
  @@unique([creatorProfileId, platform])
  @@index([creatorProfileId])
}


model VerificationRequest {
  id           String    @id @default(cuid())
  userId       String
  status       String    @default("PENDING")
  note         String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  applicant    User      @relation("VerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer     User?     @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Campaign {
  id             String   @id @default(cuid())
  brandId        String
  title          String
  brief          String
  coverImageUrl  String?
  objectives     String[]
  categories     String[]
  platforms      String[]
  location       String?
  budgetMin      Int?
  budgetMax      Int?
  currency       String   @default("INR")
  slots          Int      @default(1)
  applicationDeadline DateTime?
  startDate      DateTime?
  endDate        DateTime?
  status         String   @default("DRAFT")
  managementMode String   @default("SELF_SERVICE")
  assignedManagerId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  assignedManager User?    @relation("CampaignManager", fields: [assignedManagerId], references: [id], onDelete: SetNull)
  applications   CampaignApplication[]
  collaborations Collaboration[]
  invitations    CampaignInvitation[]
  briefAttachments CampaignBriefAttachment[]
  @@index([status, createdAt])
  @@index([brandId, status])
  @@index([assignedManagerId, status])
}

model CampaignApplication {
  id               String   @id @default(cuid())
  campaignId       String
  creatorProfileId String
  pitch            String
  proposedRate     Int?
  status           String   @default("SUBMITTED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  collaboration   Collaboration?
  @@unique([campaignId, creatorProfileId])
  @@index([campaignId, status])
  @@index([creatorProfileId, status])
}

model Collaboration {
  id            String   @id @default(cuid())
  campaignId    String
  applicationId String   @unique
  creatorProfileId String
  status        String   @default("PENDING_START")
  agreedAmount  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  application   CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  messages      CollaborationMessage[]
  deliverables  Deliverable[]
  milestones    CollaborationMilestone[]
  agreement     CollaborationAgreement?
  @@index([creatorProfileId, status])
  @@index([campaignId, status])
}

model CollaborationMessage {
  id              String   @id @default(cuid())
  collaborationId String
  senderId        String
  body            String
  readAt          DateTime?
  editedAt        DateTime?
  createdAt       DateTime @default(now())
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  sender          User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([collaborationId, createdAt])
  @@index([collaborationId, readAt])
}

model Deliverable {
  id              String   @id @default(cuid())
  collaborationId String
  title           String
  description     String?
  assetUrl        String?
  dueAt           DateTime?
  status          String   @default("PENDING")
  feedback        String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  submissionVersion Int @default(0)
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  submissions     DeliverableSubmission[]
  @@index([collaborationId, status])
}

model CollaborationAgreement {
  id              String   @id @default(cuid())
  collaborationId String   @unique
  title           String
  terms           String
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  currentVersion  Int @default(1)
  versions        CollaborationAgreementVersion[]
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
}


model DeliverableSubmission {
  id            String   @id @default(cuid())
  deliverableId String
  version       Int
  assetUrl      String
  note          String?
  submittedById String
  createdAt     DateTime @default(now())
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  attachments   DeliverableSubmissionAttachment[]
  @@unique([deliverableId, version])
  @@index([deliverableId, createdAt])
}

model CollaborationAgreementVersion {
  id          String   @id @default(cuid())
  agreementId String
  version     Int
  title       String
  terms       String
  status      String   @default("DRAFT")
  createdById String
  acceptedAt  DateTime?
  brandAcceptedAt DateTime?
  brandAcceptedById String?
  brandAcceptedName String?
  brandAcceptedIp String?
  brandAcceptedUserAgent String?
  creatorAcceptedAt DateTime?
  creatorAcceptedById String?
  creatorAcceptedName String?
  creatorAcceptedIp String?
  creatorAcceptedUserAgent String?
  createdAt   DateTime @default(now())
  agreement   CollaborationAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  @@unique([agreementId, version])
  @@index([agreementId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}


model BrandShortlistItem {
  id               String         @id @default(cuid())
  brandId          String
  creatorProfileId String
  createdAt        DateTime       @default(now())
  brand            Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  @@unique([brandId, creatorProfileId])
  @@index([brandId, createdAt])
}

model CampaignInvitation {
  id               String         @id @default(cuid())
  brandId          String
  campaignId       String
  creatorProfileId String
  invitedByUserId  String
  status           String         @default("PENDING")
  note             String?
  proposedRate     Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  brand            Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign         Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  invitedBy        User            @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)
  @@unique([campaignId, creatorProfileId])
  @@index([creatorProfileId, status, createdAt])
  @@index([brandId, createdAt])
}


model CampaignBriefAttachment {
  id           String   @id @default(cuid())
  campaignId   String
  fileName     String
  url          String   @db.Text
  publicId     String?
  resourceType String   @default("raw")
  bytes        Int      @default(0)
  createdAt    DateTime @default(now())
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@index([campaignId, createdAt])
}

model DeliverableSubmissionAttachment {
  id           String   @id @default(cuid())
  submissionId String
  fileName     String
  url          String   @db.Text
  publicId     String?
  resourceType String   @default("raw")
  bytes        Int      @default(0)
  createdAt    DateTime @default(now())
  submission   DeliverableSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  @@index([submissionId, createdAt])
}


model MediaAsset {
  id           String   @id @default(cuid())
  ownerUserId  String
  publicId     String   @unique
  resourceType String
  secureUrl    String   @db.Text
  context      String
  bytes        Int
  format       String
  createdAt    DateTime @default(now())
  linkedAt     DateTime?
  owner        User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  @@index([linkedAt, createdAt])
  @@index([ownerUserId, context])
}


enum CollaborationMilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model CollaborationMilestone {
  id              String                       @id @default(cuid())
  collaborationId String
  title           String                       @db.VarChar(120)
  description     String?                      @db.VarChar(1000)
  dueAt           DateTime?
  status          CollaborationMilestoneStatus @default(PENDING)
  createdById     String
  completedById   String?
  completedAt     DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  collaboration   Collaboration                @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  @@index([collaborationId, status])
  @@index([dueAt, status])
}
