# App / Better Auth
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional Google OAuth (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# PostgreSQL / Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require"

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=

# Cloudinary media storage (required for direct uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Protect the scheduled orphan-media cleanup endpoint
CRON_SECRET=
