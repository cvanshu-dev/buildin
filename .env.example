# Better Auth
# Generate a secure secret with: npm run auth:secret
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional Google OAuth (leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Neon PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Optional email delivery integration (password reset / verification emails
# require a mail provider and sendEmail configuration before production use)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
